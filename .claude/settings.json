{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": false,
  "enableAllProjectMcpServers": true,
  "disabledMcpjsonServers": [
    "chrome-devtools",
    "obs",
    "plaid",
    "playwright-test",
    "remotion",
    "render",
    "resend",
    "vercel"
  ],
  "enabledPlugins": {
  },
  "permissions": {
    "allow": [],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(./.env)",
      "Read(./.env.enc)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./.envrc)",
      "Read(./secrets/**)",
      "Read(./supabase/.temp/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "mcp__supabase-main__apply_migration"
    ]
  },
  "plansDirectory": ".claude/plans"
}